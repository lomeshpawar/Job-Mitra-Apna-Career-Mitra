# ========================================================
# Job Mitra — Environment Configuration Template
# Copy this file to '.env' and supply secure values.
# NEVER commit real production credentials or API keys.
# ========================================================

# Application Core Settings
PORT=5000
FLASK_DEBUG=False
# Generate a strong 64-char key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key

# Session Security (set to True in production with HTTPS)
SESSION_COOKIE_SECURE=False

# Database Engine: 'sqlite', 'mysql', or 'auto'
# In local development, 'auto' or 'sqlite' uses 'jobmitra_local.db' with zero extra setup.
DB_ENGINE=sqlite

# MySQL Database Settings (when DB_ENGINE is 'mysql')
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jobmitra_portal

# Payment Gateway Configuration
# Set PAYMENT_GATEWAY_LIVE=True only when live credentials have been tested.
PAYMENT_GATEWAY_LIVE=False
PAYMENT_GATEWAY_NAME="Manual UPI Verification / Demo"
UPI_ID=your-business-upi@bank

# Optional Gateway API Keys (Leave empty for demo/manual verification mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional SMTP Mail Dispatch Settings
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@jobmitra.in

# Initial Admin Bootstrap (Optional non-interactive setup)
# ADMIN_EMAIL=admin@jobmitra.in
# ADMIN_NAME="Super Administrator"
# ADMIN_PASSWORD="YourStrongPassword123!"
